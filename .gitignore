# ============================================================================
# GITIGNORE - Sistema de Estoques de Computadores
# ============================================================================
# Este arquivo protege informações sensíveis e arquivos desnecessários
# de serem commitados no repositório Git
# ============================================================================

# ============================================================================
# ARQUIVOS SENSÍVEIS - CREDENCIAIS E SENHAS
# ============================================================================

# Arquivos de ambiente com credenciais
**/.env
**/.env.local
**/.env.*.local
**/.env.production
**/.env.development
.env
.env.local
.env.*.local

# Arquivos de configuração com senhas
**/config.local.*
**/secrets.*

# ============================================================================
# BANCO DE DADOS
# ============================================================================

# Dumps e backups de banco de dados
*.sql.backup
*.sql.bak
*.dump
*.dmp
**/backup/
**/dumps/

# Arquivos de banco de dados local
*.db
*.sqlite
*.sqlite3

# ============================================================================
# PYTHON
# ============================================================================

# Ambientes virtuais
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
**/venv/
**/.venv/

# Bytecode Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribuição / Empacotamento
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Testes
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ============================================================================
# IDEs E EDITORES
# ============================================================================

# Visual Studio Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ============================================================================
# SISTEMA OPERACIONAL
# ============================================================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# ============================================================================
# LOGS E TEMPORÁRIOS
# ============================================================================

# Logs
*.log
logs/
*.log.*

# Arquivos temporários
*.tmp
*.temp
*.cache
.cache/

# ============================================================================
# NODE.JS / FRONTEND (caso adicione futuramente)
# ============================================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ============================================================================
# OUTROS
# ============================================================================

# Arquivos de sistema
.Trash-*
.nfs*

# Certificados e chaves
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Arquivos compactados (opcional - remova se precisar versionar)
# *.zip
# *.tar.gz
# *.rar
