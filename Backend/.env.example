# ============================================================================
# CONFIGURAÇÃO DO BANCO DE DADOS POSTGRESQL (SUPABASE)
# ============================================================================
#
# Este é um arquivo de exemplo. Copie para .env e configure com suas credenciais.
#
# IMPORTANTE: Nunca commite o arquivo .env com credenciais reais!
# ============================================================================

# URL de conexão PostgreSQL (obrigatória)
# Se a URL do Supabase vier como postgres://, o backend converte para postgresql://
DATABASE_URL=postgresql://postgres:sua_senha@db.xxxx.supabase.co:5432/postgres

# ============================================================================
# CONFIGURAÇÕES DA API
# ============================================================================

API_TITLE=Estoque TI API
API_VERSION=1.0.0
API_PREFIX=/api

# ============================================================================
# JWT (autenticação) — OBRIGATÓRIO
# ============================================================================
# Sem esta variável (ou com valor placeholder), a API NÃO inicia.
# Gere uma chave longa e aleatória, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-esta-chave-por-uma-secreta-longa
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ============================================================================
# INSTRUÇÕES DE USO
# ============================================================================
#
# 1. Copie este arquivo para .env:
#    cp .env.example .env
#
# 2. Edite o arquivo .env com a DATABASE_URL real do Supabase
#    (Settings → Database → Connection string → URI)
#
# 3. Instale as dependências:
#    pip install -r requirements.txt
#
# 4. Crie as tabelas:
#    python init_db.py
#
# 5. Inicie a API:
#    python -m uvicorn app.main:app --reload
#
# ============================================================================
