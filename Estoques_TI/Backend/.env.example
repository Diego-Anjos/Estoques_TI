# ============================================================================
# CONFIGURAÇÃO DO BANCO DE DADOS ORACLE
# ============================================================================
# 
# Este é um arquivo de exemplo. Copie para .env e configure com suas credenciais.
# 
# IMPORTANTE: Nunca commite o arquivo .env com credenciais reais!
# ============================================================================

# Credenciais do Oracle Database
ORACLE_USER=seu_usuario_oracle
ORACLE_PASSWORD=sua_senha_oracle

# DSN (Data Source Name) - Formato: host:porta/servico
# Exemplos:
#   - Oracle XE local: localhost:1521/XEPDB1
#   - Oracle remoto: 192.168.1.100:1521/ORCL
#   - Servidor produção: servidor.empresa.com:1521/PROD
ORACLE_DSN=localhost:1521/XEPDB1

# Configurações do Pool de Conexões
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_POOL_INC=1

# ============================================================================
# CONFIGURAÇÕES DA API
# ============================================================================

API_TITLE=Estoque TI API
API_VERSION=1.0.0
API_PREFIX=/api

# ============================================================================
# INSTRUÇÕES DE USO
# ============================================================================
#
# 1. Copie este arquivo para .env:
#    cp .env.example .env
#
# 2. Edite o arquivo .env com suas credenciais reais
#
# 3. Execute o script de teste:
#    python test_connection.py
#
# 4. Se tudo estiver OK, inicie a API:
#    python -m uvicorn app.main:app --reload
#
# ============================================================================
